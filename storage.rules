rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_group_images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /chat_media/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /chat_audio/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /profile_pics/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}