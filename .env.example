# SquadSync Flutter App Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# IGDB API Credentials (from Twitch Developer Console)
# Get from: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Twitch API (optional - for Twitch integration features)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api
# Auth → URL Configuration must include:
#   com.example.codSquadApp://auth-callback
# (parked iOS bundle ID; replaces leftover com.squadsync.app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Google Sign-In (OAuth client IDs — these are public identifiers, not secrets)
# Web/server client ID is required by google_sign_in 7 for ID tokens.
# From Firebase Console → Project settings → Your apps → Web client ID
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# After you drop in a real GoogleService-Info.plist (gitignored):
#   CLIENT_ID            → GIDClientID in ios/Runner/Info.plist
#   REVERSED_CLIENT_ID   → google.sign.in CFBundleURLSchemes
#   CLIENT_ID            → GOOGLE_IOS_CLIENT_ID here
# Leave YOUR_ placeholders in git. The Google button fails closed until these
# are filled locally. On a device/simulator also:
#   flutter run --dart-define-from-file=.env
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# iOS Firebase: copy ios/Runner/GoogleService-Info.plist.example →
# ios/Runner/GoogleService-Info.plist (gitignored) and paste Firebase values.
# A build-phase script copies the example if missing so the Xcode resource
# exists. Do not commit the real plist.
#
# .env is gitignored and is NOT bundled as a Flutter asset. Copy this file
# to .env for desktop/CI. Secrets in .env stay off the IPA.

# Agora (for voice/video rooms)
# Get from: https://console.agora.io/
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# xAI Grok API Key (optional - only if calling Grok directly from app)
# Usually handled by backend, but can be set here for testing
# Get from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key
