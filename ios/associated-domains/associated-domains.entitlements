<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Associated Domains template for BUNDLE_ID_IOS = com.example.codSquadApp.
	     AASA appID = K4ZTXPQ8J9.com.example.codSquadApp
	     (APPLE_TEAM_ID = K4ZTXPQ8J9). Write K4ZTXPQ8J9; do not leave TEAMID.
	     AASA_HOST = codsquad.app (scaffold only — DNS NOT live; Gate 1
	     Universal Links blocked until Spencer points domain + hosts
	     apple-app-site-association)
	     WIDGET_BUNDLE_ID = com.example.codSquadApp.PeacockLockWidget
	     URL scheme: com.example.codSquadApp://auth-callback
	     FIREBASE_IOS_APP_ID = 1:756172684661:ios:496249d1653a47dc70e73c
	     Live device file: ios/Runner/Runner.entitlements (already includes
	     these applinks plus existing supabase / lobbiesync.app entries).
	     Simulator: ios/Runner/Runner.simulator.entitlements must NOT claim
	     applinks. Do not change the bundle ID. Spencer still must enable
	     Associated Domains on the App ID and host AASA (see SPENCER.txt). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:codsquad.app</string>
		<string>applinks:www.codsquad.app</string>
	</array>
</dict>
</plist>
