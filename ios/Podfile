# Define platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  platform :ios, '15.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# permission_handler compiles out unused permission APIs unless these macros are set.
PERMISSION_HANDLER_MACROS = [
  'PERMISSION_CAMERA=1',
  'PERMISSION_MICROPHONE=1',
  'PERMISSION_PHOTOS=1',
  'PERMISSION_PHOTOS_ADD_ONLY=1',
  'PERMISSION_NOTIFICATIONS=1',
  'PERMISSION_SPEECH_RECOGNIZER=1',
].freeze

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Do not hardcode a DEVELOPMENT_TEAM or force Apple Development on pods.
      # That blocks clones and simulator builds for anyone without that team.
      # Flutter + Xcode Automatic signing handle the Runner target; pods stay unsigned.
      config.build_settings.delete('DEVELOPMENT_TEAM')
      config.build_settings.delete('CODE_SIGN_IDENTITY')
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'

      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      extra = PERMISSION_HANDLER_MACROS
      if defs.nil?
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)'] + extra
      elsif defs.is_a?(Array)
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = (defs + extra).uniq
      else
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ([defs] + extra).uniq
      end

      # Suppress ambiguous macro warning for SQLCipher
      if target.name == 'SQLCipher'
        config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
        config.build_settings['WARNING_CFLAGS'] = '-Wno-ambiguous-macro'
      end

      # Remove duplicate library flags to fix linking warnings
      if config.build_settings['OTHER_LDFLAGS']
        flags = config.build_settings['OTHER_LDFLAGS']
        if flags.is_a?(Array)
          config.build_settings['OTHER_LDFLAGS'] = flags.uniq
        elsif flags.is_a?(String)
          flags_array = flags.split(' ')
          config.build_settings['OTHER_LDFLAGS'] = flags_array.uniq.join(' ')
        end
      end
    end
  end
end
