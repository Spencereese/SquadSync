# SquadSync Flutter App Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# IGDB API Credentials (from Twitch Developer Console)
# Get from: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Twitch API (optional - for Twitch integration features)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Agora (for voice/video rooms)
# Get from: https://console.agora.io/
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# xAI Grok API Key (optional - only if calling Grok directly from app)
# Usually handled by backend, but can be set here for testing
# Get from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key