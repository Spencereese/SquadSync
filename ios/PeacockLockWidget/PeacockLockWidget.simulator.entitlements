<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator widget: App Groups only. No associated-domains.
	     Do not point iphonesimulator* at the device entitlements file. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.codSquadApp</string>
	</array>
</dict>
</plist>
