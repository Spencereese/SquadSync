<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<!-- Simulator only: no associated-domains. This file is the DEFAULT
	     CODE_SIGN_ENTITLEMENTS so an sdk-mismatch cannot leak device applinks
	     into Launch Services. Device builds use Runner.entitlements via
	     CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]. -->
</dict>
</plist>
