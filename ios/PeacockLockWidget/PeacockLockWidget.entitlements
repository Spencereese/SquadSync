<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Device widget entitlements. No aps-environment. No applinks.
	     Spencer: enable App Groups on App ID
	     com.example.codSquadApp.PeacockLockWidget — see SPENCER.txt. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.codSquadApp</string>
	</array>
</dict>
</plist>
